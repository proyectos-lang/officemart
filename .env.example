# ============================================================
# EasyCount - Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# En Vercel: Settings > Environment Variables (agregar las 4).
# ============================================================

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service Role Key (Project Settings > API > service_role)
# SOLO se usa en Server Actions (creacion de usuarios). NUNCA exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google Gemini (para "Recepcion por Factura" - lectura de facturas con IA)
# https://aistudio.google.com/apikey
# Solo se usa en el servidor (app/api/procesar-factura); no se expone al navegador.
GEMINI_API_KEY=AIza...

# Firma digital (officemart-017): correo con los enlaces de firma vía Resend.
# Opcional: sin estas variables la app funciona copiando el enlace manualmente.
# RESEND_FROM debe ser un remitente de un dominio verificado en resend.com.
RESEND_API_KEY=
RESEND_FROM="EasyCount <no-reply@tudominio.com>"
